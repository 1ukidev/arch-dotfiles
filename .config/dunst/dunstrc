[global]
    monitor = 0
    follow = keyboard
    width = 350
    height = (0, 350)
    offset = (10, 4)
    padding = 8
    horizontal_padding = 4
    transparency = 25
    frame_width = 1
    font = sans-serif 11
    format = "<b>%s</b>\n%b"
    icon_position = off
    corner_radius = 10

[urgency_low]
    background = "#11111188"
    foreground = "#dddddd"
    frame_color = "#333333"
    timeout = 3

[urgency_normal]
    background = "#11111188"
    foreground = "#dddddd"
    frame_color = "#333333"
    timeout = 5

[urgency_critical]
    background = "#11111188"
    foreground = "#dddddd"
    frame_color = "#333333"
    timeout = 10
